-                break;
+        uint32_t pending = 0;
+        for (int source = 0; source < ESP32S3_INT_MATRIX_INPUTS; ++source) {
+            if (s->input_level[source]) {
+                pending |= 1U << IRQ_MAP(cpu, source);
+            }
+        }
+        uint32_t changed = pending ^ s->output_levels[cpu];
+        s->output_levels[cpu] = pending;
+        for (int index = 0; index < s->cpu[cpu]->env.config->nextint; ++index) {
+            uint32_t bit = 1U << s->cpu[cpu]->env.config->extint[index];
+            if (changed & bit) {
+                qemu_set_irq(s->outputs[cpu][index], (pending & bit) != 0);
             }
         }
     }
 }
 
+static void esp32s3_intmatrix_irq_handler(void *opaque, int n, int level)
+{
+    Esp32s3IntMatrixState *s = ESP32S3_INTMATRIX(opaque);
+    if (s->input_level[n] == (level != 0)) {
+        return;
+    }
+    s->input_level[n] = level != 0;
+    esp32s3_intmatrix_update(s);
+}
