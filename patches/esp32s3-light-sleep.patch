+#define RTC_TIMER_WAKEUP BIT(3)
+#define RTC_TIMER_MASK ((1ULL << 48) - 1)
+
+static uint64_t esp32s3_rtc_ticks(Esp32s3RtcCntlState *s)
+{
+    return (s->time_base_ticks + muldiv64(
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->time_base_ns,
+        s->rtc_slowclk_freq, NANOSECONDS_PER_SECOND)) & RTC_TIMER_MASK;
+}
+
+static void esp32s3_rtc_update_irq(Esp32s3RtcCntlState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_enable) != 0);
+}
+
+static uint32_t esp32s3_rtc_ext1_active(Esp32s3RtcCntlState *s)
+{
+    uint32_t levels = FIELD_EX32(s->ext_wakeup_conf, RTC_CNTL_EXT_WAKEUP_CONF, EXT1_HIGH)
+                      ? s->gpio_levels : ~s->gpio_levels;
+    return levels & s->ext1_select;
+}
+
+static uint32_t esp32s3_rtc_pending(Esp32s3RtcCntlState *s)
+{
+    uint32_t sources = esp32s3_rtc_ext1_active(s) ? RTC_EXT1_WAKEUP : 0;
+    if (s->int_raw & R_RTC_CNTL_INT_RAW_MAIN_TIMER_MASK) {
+        sources |= RTC_TIMER_WAKEUP;
+    }
+    return sources;
+}
+
+static void esp32s3_rtc_wake(Esp32s3RtcCntlState *s)
+{
+    uint32_t cause = esp32s3_rtc_pending(s) & s->wakeup_enable;
+    if (!s->sleeping || !cause) {
+        return;
+    }
+
+    s->wakeup_cause = cause;
+    if (cause & RTC_EXT1_WAKEUP) {
+        s->ext1_status = esp32s3_rtc_ext1_active(s);
+    }
+    trace_esp32s3_rtc_wake(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), cause, s->ext1_status);
+    s->int_raw |= R_RTC_CNTL_INT_RAW_SLP_WAKEUP_MASK;
+    s->state_reg &= ~R_RTC_CNTL_STATE0_SLEEP_EN_MASK;
+    s->sleeping = false;
+    esp32s3_rtc_update_cpu_stall(s);
+    esp32s3_rtc_update_irq(s);
+}
+
+static void esp32s3_rtc_sleep(Esp32s3RtcCntlState *s)
+{
+    uint32_t reject = esp32s3_rtc_pending(s) &
+                      FIELD_EX32(s->reject_conf, RTC_CNTL_SLP_REJECT_CONF, ENABLE);
+    s->wakeup_cause = 0;
+    if (reject && FIELD_EX32(s->reject_conf, RTC_CNTL_SLP_REJECT_CONF, LIGHT_SLEEP)) {
+        trace_esp32s3_rtc_reject(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), reject);
+        s->reject_cause = reject;
+        s->state_reg &= ~R_RTC_CNTL_STATE0_SLEEP_EN_MASK;
+        s->int_raw |= R_RTC_CNTL_INT_RAW_SLP_REJECT_MASK;
+        esp32s3_rtc_update_irq(s);
+        return;
+    }
+
+    /* Keep RAM and CPU registers intact; only execution is suspended. */
+    trace_esp32s3_rtc_sleep(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), s->alarm_ticks, s->wakeup_enable);
+    s->sleeping = true;
+    esp32s3_rtc_wake(s);
+    esp32s3_rtc_update_cpu_stall(s);
+}
+
+static void esp32s3_rtc_gpio_input(void *opaque, int pin, int level)
+{
+    Esp32s3RtcCntlState *s = opaque;
+    s->gpio_levels = deposit32(s->gpio_levels, pin, 1, level != 0);
+    esp32s3_rtc_wake(s);
+}
+
+static void esp32s3_rtc_alarm(void *opaque)
+{
+    Esp32s3RtcCntlState *s = opaque;
+    s->alarm_enabled = false;
+    s->int_raw |= R_RTC_CNTL_INT_RAW_MAIN_TIMER_MASK;
+    esp32s3_rtc_wake(s);
+    esp32s3_rtc_update_irq(s);
+}
+
+static void esp32s3_rtc_schedule_alarm(Esp32s3RtcCntlState *s)
+{
+    timer_del(&s->alarm_timer);
+    if (!s->alarm_enabled) {
+        return;
+    }
+
+    uint64_t ticks = (s->alarm_ticks - esp32s3_rtc_ticks(s)) & RTC_TIMER_MASK;
+    /* Deadlines in the past fire immediately, including across counter wrap. */
+    if (ticks == 0 || ticks > RTC_TIMER_MASK / 2) {
+        esp32s3_rtc_alarm(s);
+        return;
+    }
+    uint64_t delay_ns = muldiv64(ticks, NANOSECONDS_PER_SECOND, s->rtc_slowclk_freq);
+    timer_mod(&s->alarm_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + delay_ns + 1);
+}
